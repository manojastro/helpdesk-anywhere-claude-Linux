# Node
node_modules/
dist/
npm-debug.log*

# Secrets — never commit (CLAUDE.md conventions).
# Broad by design: any .env variant is ignored, and .env.example — placeholders
# only — is the one exception.
.env
.env.*
!.env.example

# ngrok and cloud credentials, wherever a tool decides to drop them.
ngrok.yml
.ngrok2/
*.pem
*.key
!**/testdata/*.key

# Built Windows binaries (produced by scripts/build-windows.sh)
server/public/download/*.exe
server/public/download/*.pdb

# Published copy of the MT-06 diagnostic (scripts/publish-diagnostics.sh). The
# source of truth is scripts/mt06-diagnostics.ps1; committing the copy too would
# let the published file drift from the one the tests validate.
server/public/download/*.ps1

# .NET
bin/
obj/
*.user

# Runtime data
audit/*.jsonl
caddy_data/
caddy_config/

# Editors / OS
.vscode/
.idea/
.DS_Store
