# PLAN 7.3, admin-portal release. Caddy obtains and renews a Let's Encrypt
# certificate for EACH hostname automatically and proxies WebSocket upgrades
# with no extra config.
#
# Two sites, two applications, one backend container:
#   {$PUBLIC_HOST}        app.<domain>    → app:8080  technician console, customer
#                                                     join page, applet download, /ws
#   {$ADMIN_PUBLIC_HOST}  admin.<domain>  → app:8081  admin portal only (no /ws,
#                                                     no join page, no download)
#
# Authentication is done by the application (Entra ID), not here, so it holds in
# every deployment mode. Each application issues its own host-only `__Host-`
# cookie; the two hostnames never share a session. See docs/OPERATIONS.md
# "Separate subdomains" for why SameSite alone is not relied on between them.
#
# Used only by the `tls` compose profile:
#   docker compose --profile tls up -d --build     (or scripts/deploy.sh)

{$PUBLIC_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# The applet .exe, served straight from where build-windows.sh drops it.
	handle /download/* {
		root * /srv/public
		file_server
	}

	reverse_proxy app:8080
}

{$ADMIN_PUBLIC_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Optional hardening: restrict the admin portal to known networks. Entra ID
	# sign-in (plus Conditional Access, if you use it) is the real control; this
	# only shrinks who can reach the sign-in page. Uncomment and edit to use:
	# @outside not remote_ip 203.0.113.0/24 198.51.100.7/32
	# respond @outside "Not available" 403

	reverse_proxy app:8081
}
