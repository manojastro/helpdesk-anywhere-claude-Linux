# PLAN 7.3. Caddy obtains and renews the Let's Encrypt certificate automatically
# and handles the WSS upgrade through reverse_proxy with no extra config.
#
# TODO (Phase 7, not later): the agent console has NO authentication. Before this
# goes on a public hostname, protect the console route with basic_auth — generate
# the hash with `caddy hash-password`. `/j/*` and `/download/*` must stay
# unauthenticated; end users need them.
#
#   @console not path /j/* /download/* /healthz
#   basic_auth @console {
#       agent <bcrypt-hash-from-caddy-hash-password>
#   }

{$PUBLIC_HOST} {
	encode zstd gzip

	# The applet .exe, served straight from where build-windows.sh drops it.
	handle /download/* {
		root * /srv/public
		file_server
	}

	reverse_proxy app:8080
}
