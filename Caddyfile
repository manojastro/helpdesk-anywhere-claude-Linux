# PLAN 7.3. Caddy obtains and renews the Let's Encrypt certificate automatically
# and handles the WSS upgrade through reverse_proxy with no extra config.
#
# Console authentication is handled by the APP, not here (server/src/auth.ts,
# DECISIONS.md D-007). It was moved there so it also protects the ngrok profile,
# where there is no Caddy in the path at all, and so it can gate the console's
# WebSocket as well as its page — which a proxy-level basic_auth cannot do.
# Set CONSOLE_PASSWORD in .env. `/j/*`, `/download/*` and `/healthz` stay open,
# because the end user has no credentials and must not need any.
#
# This file is used only by the `tls` compose profile:
#   docker compose --profile tls up -d --build     (or scripts/deploy.sh)

{$PUBLIC_HOST} {
	encode zstd gzip

	# Caddy has a real certificate here, so tell browsers to insist on it.
	# Not set in the ngrok profile: that hostname is not ours to pin.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# The applet .exe, served straight from where build-windows.sh drops it.
	handle /download/* {
		root * /srv/public
		file_server
	}

	reverse_proxy app:8080
}
