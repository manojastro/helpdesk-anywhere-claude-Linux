<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs as SYSTEM in the user's session, attached to a named desktop
       (usually Winlogon). Reuses GdiCapture and InputInjector from Phases 3-4 —
       which is why those are written as reusable classes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>HelpdeskAnywhere.DesktopHelper</RootNamespace>
    <AssemblyName>DesktopHelper</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
