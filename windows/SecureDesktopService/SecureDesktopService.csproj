<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs as LocalSystem in session 0. Installed at session start and
       UNINSTALLED at session end (CLAUDE.md constraint #4) — nothing survives
       reboot. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>HelpdeskAnywhere.SecureDesktopService</RootNamespace>
    <AssemblyName>SecureDesktopService</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- The desktop APIs are the applet's, compiled in rather than duplicated:
       OpenInputDesktop and GetUserObjectInformation are the same calls the helper
       makes, and two copies would drift. -->
  <ItemGroup>
    <Compile Include="..\Applet\Interop\Desktops.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
