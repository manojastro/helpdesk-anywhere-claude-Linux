# Copy to .env and fill in. NEVER commit .env (CLAUDE.md conventions).

# Public hostname the portal reports in its startup log and health check.
#
#   tls   profile (permanent): the DuckDNS subdomain Caddy gets a Let's Encrypt
#                              certificate for — PLAN 7.2.
#   cloudflared profile (temporary, recommended): the quick tunnel's hostname,
#     e.g. two-random-words-here.trycloudflare.com. deploy-cloudflared.sh writes it.
#   ngrok profile (temporary): the tunnel's hostname, e.g. abcd-1-2-3-4.ngrok-free.app.
#
# Join links in the console are built from the browser's own origin, so this
# being briefly out of date with a random tunnel URL is cosmetic.
PUBLIC_HOST=helpdesk-anywhere.duckdns.org

# Internal port the Node server listens on. Caddy reverse-proxies 443 -> this.
# Not published to the internet directly.
PORT=8080

# Where the append-only JSONL audit log is written (Phase 1.6).
AUDIT_DIR=./audit

# Session code lifetime before an unused code expires (PLAN 1.2).
SESSION_CODE_TTL_MS=600000

# Rate limit on host.join attempts per IP (PLAN 1.2) — a 6-digit code is only
# ~1M wide, so unlimited guessing is a real hijack path.
JOIN_ATTEMPTS_PER_MINUTE=5

# Trust X-Forwarded-For / X-Forwarded-Proto on WebSocket upgrades. Set to 1 ONLY
# when a reverse proxy that sets them (Caddy, PLAN 7.3) really is in front: with
# nothing in front, a client can forge both, defeating the join rate limiter and
# faking a secure transport for credential-mode elevation.
TRUST_PROXY=0

# Max credential-mode elevation attempts per session (PLAN 5.2c rule 6).
ELEVATION_ATTEMPTS_PER_SESSION=5

# `agent.create` calls allowed per IP per minute, and a hard ceiling on live
# sessions. Every create burns a code and writes an audit record, so without
# these an unauthenticated console is an unbounded write to both (security
# review, 2026-09-03). A support agent creates one session per call; ten a
# minute is already generous.
CREATE_ATTEMPTS_PER_MINUTE=10
MAX_LIVE_SESSIONS=500

# Multi-session. The most live sessions one technician may hold at once (1–20);
# the effective limit is the smaller of this and the account's own limit in the
# admin portal. Every live session counts: waiting for a customer, awaiting
# consent, active, and reconnecting.
MAX_CONCURRENT_SESSIONS_PER_AGENT=4
# How long a session survives its technician's socket dropping (network blip,
# page reload) before it ends as agent_disconnected. Only the same signed-in
# technician with that session's resume token can pick it back up. 0 = end at
# once, as before multi-session.
AGENT_RECONNECT_GRACE_MS=60000

# Extra browser origins allowed to open the /ws socket, comma-separated. Leave
# empty unless the console is served from a DIFFERENT hostname than PUBLIC_HOST:
# the request's own Host is always allowed, and every non-browser client — the
# applet included — sends no Origin at all and is always allowed. What this
# guards is cross-site WebSocket hijacking from another site in the agent's
# browser.
ALLOWED_ORIGINS=

# Set to 1 only for local plain-HTTP development. Credential-mode elevation is
# hard-refused unless the connection is wss: (PLAN 5.2c rule 1); this flag must
# never be set in a deployed environment.
ALLOW_INSECURE_DEV=0

# ------------------------------------------------------------ container identity
# The uid/gid the app container runs as. It MUST be able to write ./audit, which
# is bind-mounted into the container: if these do not match the directory's
# owner, the audit log silently fails and the server now refuses to start
# (CLAUDE.md constraint #5).
#
# The deploy scripts set these from `id -u` / `id -g` automatically; set them
# here only if you run `docker compose` by hand.
HOST_UID=1000
HOST_GID=1000

# ------------------------------------------------------ admin portal hostname
# The admin portal is a SEPARATE application on its own hostname. In the tls
# profile Caddy gets a certificate for it too, so it needs its own DNS record
# (a second DuckDNS subdomain works). Must differ from PUBLIC_HOST.
#   PUBLIC_HOST=hda-app.duckdns.org        technician console + customer join
#   ADMIN_PUBLIC_HOST=hda-admin.duckdns.org admin portal
ADMIN_PUBLIC_HOST=helpdesk-anywhere-admin.duckdns.org
# Loopback port the admin portal is also bound to on the VM (SSH-tunnel access).
ADMIN_LOCAL_PORT=8081

# ------------------------------------------------------------------ database
# PostgreSQL runs as the `db` compose service. URL-safe value, e.g.:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Apply schema migrations at startup (under an advisory lock). Set 0 to run
# them only by hand:  docker compose run --rm app node dist/db/migrate.js
DB_MIGRATE_ON_START=1

# ------------------------------------------------------- Microsoft Entra ID
# Sign-in for BOTH the technician console and the admin portal (docs/ENTRA_SETUP.md).
# The customer running the applet never signs in.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret VALUE (not its ID). Never commit it; rotate before it expires.
ENTRA_CLIENT_SECRET=replace-with-client-secret-value
# Redirect URIs default to https://<PUBLIC_HOST>/auth/callback and
# https://<ADMIN_PUBLIC_HOST>/auth/callback — register exactly those two in
# Entra. Override only if you front the app differently.
OIDC_REDIRECT_URI_AGENT=
OIDC_REDIRECT_URI_ADMIN=

# First administrator: the Entra OBJECT ID(s) allowed to become the first admin.
# Takes effect only for an identity that also holds the Admin app role, while no
# active admin exists. Clear it once your first admin has signed in.
BOOTSTRAP_ADMIN_OIDS=

ORG_NAME=Helpdesk Anywhere

# Browser-session idle timeout and absolute lifetime.
AUTH_IDLE_MINUTES=120
AUTH_MAX_HOURS=12

# "Agents online" = distinct technicians with a console heartbeat this recent.
PRESENCE_WINDOW_SECONDS=90

# ----------------------------------------------------------------- retention
# Chat transcripts and technician notes: deleted this many days after a session
# ends (the session keeps a "deleted by retention" marker). 0 = keep forever.
TRANSCRIPT_RETENTION_DAYS=365
# Whole session records and timelines. 0 = keep forever.
SESSION_RETENTION_DAYS=730
# Administrative audit trail. 0 = keep forever (default).
AUDIT_RETENTION_DAYS=0
# Generated PDF/CSV reports are downloadable for this long, then erased.
REPORT_TTL_MINUTES=15
# Day boundary for "today" on the dashboard (IANA name).
REPORT_TIMEZONE=UTC

# AUTH_MODE is fixed to `entra` by docker-compose.yml. `dev` (a local sign-in
# form with no Microsoft account) exists only for `npm run dev` / tests on a
# loopback host, and the server refuses to start with it under NODE_ENV=production.

# ----------------------------------------------- cloudflared (temporary, default)
# The `cloudflared` compose profile needs NOTHING here: a Cloudflare quick tunnel
# takes no account and no token (DECISIONS.md D-011). scripts/deploy-cloudflared.sh
# writes the hostname it is given into PUBLIC_HOST above.
#
# ------------------------------------------------------------ ngrok (temporary)
# Only needed for the `ngrok` compose profile — the temporary external-access
# path used while no DNS exists (scripts/deploy-ngrok.sh).
#
# Get the token from https://dashboard.ngrok.com → "Your Authtoken".
# NEVER commit a real value: .env is gitignored, this file holds placeholders only.
NGROK_AUTHTOKEN=

# Optional. A reserved static domain from the ngrok dashboard, so the URL
# survives a restart and the applet does not need rebuilding each time.
# Leave empty to let ngrok assign a random URL.
# Example: NGROK_URL=https://helpdesk-anywhere.ngrok-free.app
NGROK_URL=
