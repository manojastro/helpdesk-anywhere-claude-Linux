# Copy to .env and fill in. NEVER commit .env (CLAUDE.md conventions).

# Public hostname Caddy obtains a Let's Encrypt certificate for, and the host the
# portal builds join links from: https://$PUBLIC_HOST/j/<code>
# Phase 7.2 — a free DuckDNS subdomain pointed at this VM's public IP.
PUBLIC_HOST=helpdesk-anywhere.duckdns.org

# Internal port the Node server listens on. Caddy reverse-proxies 443 -> this.
# Not published to the internet directly.
PORT=8080

# Where the append-only JSONL audit log is written (Phase 1.6).
AUDIT_DIR=./audit

# Session code lifetime before an unused code expires (PLAN 1.2).
SESSION_CODE_TTL_MS=600000

# Rate limit on host.join attempts per IP (PLAN 1.2) — a 6-digit code is only
# ~1M wide, so unlimited guessing is a real hijack path.
JOIN_ATTEMPTS_PER_MINUTE=5

# Max credential-mode elevation attempts per session (PLAN 5.2c rule 6).
ELEVATION_ATTEMPTS_PER_SESSION=5

# Set to 1 only for local plain-HTTP development. Credential-mode elevation is
# hard-refused unless the connection is wss: (PLAN 5.2c rule 1); this flag must
# never be set in a deployed environment.
ALLOW_INSECURE_DEV=0
